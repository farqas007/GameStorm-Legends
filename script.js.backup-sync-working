        ) {

            audioTimeline.stop();

        }


        if (
            audio &&
            typeof audio.stop === "function"
        ) {

            audio.stop();

        }


    videoStarted =
    false;

videoFinished =
    false;

finishing =
    false;

startInProgress =
    false;


        clearScenes();


        if (video) {

            video.classList.remove(
                "video-started"
            );

        }

    }

}


// =========================================
// RESET GAMESTORM
// =========================================

function resetGameStorm() {

    console.log(
        "🔄 GAMESTORM RESET"
    );


    // =====================================
    // STOP VISUAL LOOP
    // =====================================

    if (
        animationFrame !== null
    ) {

        cancelAnimationFrame(
            animationFrame
        );

    }


    animationFrame =
        null;


    // =====================================
    // STOP AUDIO TIMELINE
    // =====================================

    if (
        audioTimeline &&
        typeof audioTimeline.stop === "function"
    ) {

        audioTimeline.stop();

    }


    // =====================================
    // STOP AUDIO ENGINE
    // =====================================

    if (
        audio &&
        typeof audio.stop === "function"
    ) {

        audio.stop();

    }


    // =====================================
    // CLEAR VISUALS
    // =====================================

    clearScenes();


    if (video) {

        video.classList.remove(
            "video-started"
        );

    }


    // =====================================
    // RESET STATE
    // =====================================

   videoStarted =
    false;

videoFinished =
    false;

finishing =
    false;

startInProgress =
    false;


    // =====================================
    // RESET AUDIO TIMELINE
    // =====================================

    if (
        typeof audioTimeline.reset === "function"
    ) {

        audioTimeline.reset();

    }


    console.log(
        "✅ GAMESTORM INTRO READY"
    );

}


// =========================================
// USER CLICK
// =========================================
// First click = start.
// After finish, click does nothing.
// Press Escape to reset, then click again.
// =========================================

document.addEventListener(
    "click",
    startGameStorm
);


// =========================================
// ESCAPE = RESET
// =========================================

document.addEventListener(
    "keydown",
    event => {

        if (
            event.key === "Escape"
        ) {

            resetGameStorm();

        }

    }
);


// =========================================
// VISIBILITY HANDLING
// =========================================

document.addEventListener(
    "visibilitychange",
    () => {

        if (
            document.hidden
        ) {

            console.log(
                "⏸️ GAMESTORM TAB HIDDEN"
