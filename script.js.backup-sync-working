}

console.log(
    "🎵 GAMESTORM WAV MUSIC STARTED"
);


// =================================
// START STATE
// =================================

videoStarted =
    true;

startInProgress =
    false;

// =================================
// START CSS VIDEO STATE
// =================================

if (video) {

